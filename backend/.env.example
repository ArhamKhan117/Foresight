# Hedera Network Configuration
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.XXXXX
HEDERA_OPERATOR_KEY=302e020100300506032b657004220420...

# Contract Addresses (set after deployment)
PREDICTION_MARKET_CONTRACT=0.0.XXXXX
OPTIMISTIC_ORACLE_CONTRACT=0.0.XXXXX

# Fee Authority Account
FEE_AUTHORITY_ID=0.0.XXXXX

# MongoDB Connection
# Option 1: Local MongoDB
# DB_URL=mongodb://localhost:27017/hedera-prediction-market

# Option 2: Docker MongoDB
# DB_URL=mongodb://localhost:27017/hedera-prediction-market

# Option 3: MongoDB Atlas (RECOMMENDED for production)
# Replace <password> with your actual password, and update the cluster URL
DB_URL=mongodb+srv://prediction-admin:<password>@prediction-market-cluster.xxxxx.mongodb.net/hedera-prediction-market?retryWrites=true&w=majority

# Server Configuration
PORT=9000

# Initial Settings (in tinybars, 10^8 = 1 HBAR)
CREATOR_FEE_AMOUNT=100000
MARKET_COUNT=10000000
DECIMAL=8
FUND_FEE_PERCENTAGE=150
BETTING_FEE_PERCENTAGE=250

# Twitter API v2 Bearer Token (for tweet market resolution)
# Get from https://developer.x.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
