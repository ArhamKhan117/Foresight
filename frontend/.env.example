# Hedera Network
NEXT_PUBLIC_HEDERA_NETWORK=testnet

# Contract Addresses (deployed on Hedera Testnet)
NEXT_PUBLIC_PREDICTION_MARKET_CONTRACT=0x...
NEXT_PUBLIC_OPTIMISTIC_ORACLE_CONTRACT=0x...
NEXT_PUBLIC_MULTI_OUTCOME_CONTRACT=0x...
NEXT_PUBLIC_MULTI_OUTCOME_ORACLE_CONTRACT=0x...

# Fee Authority
NEXT_PUBLIC_FEE_AUTHORITY=0.0.XXXXX

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:9000

# Admin wallet address (EVM address)
NEXT_PUBLIC_ADMIN_ADDRESS=0x...

# FORE Reward Token (HTS)
NEXT_PUBLIC_FORE_TOKEN_ID=0.0.XXXXX

# Pinata (for IPFS image uploads)
NEXT_PUBLIC_PINATA_API_KEY=your_pinata_api_key
NEXT_PUBLIC_PINATA_SECRET_KEY=your_pinata_secret_key
